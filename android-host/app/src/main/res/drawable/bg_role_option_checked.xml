<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="#1A6366F1" />
            <stroke android:width="1.5dp" android:color="@color/darpan_controller" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/darpan_bg_low" />
            <stroke android:width="1dp" android:color="@color/darpan_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
