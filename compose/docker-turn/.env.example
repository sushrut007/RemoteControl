# Copy to .env and set strong values. Never commit .env.
# Clients (desktop Settings / Android Settings) must use matching TURN URL and credentials.

# Long-term credentials (coturn `user=` line). Example for turnserver.conf:
#   user=darpan_turn:CHANGE_ME_STRONG_PASSWORD
TURN_USERNAME=darpan_turn
TURN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Public hostname or IP peers use to reach coturn (not 127.0.0.1 for remote peers)
TURN_EXTERNAL_IP=203.0.113.10

# Client-facing URIs (document in USER_GUIDE — copy into app settings)
# turn:203.0.113.10:3478?transport=udp
# turns:203.0.113.10:5349?transport=tcp
